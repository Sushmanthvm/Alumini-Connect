# Supabase — copy to .env.local and fill from Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only (never expose in the browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google SSO (students + alumni) is configured in:
# Google Cloud Console OAuth client + Supabase Auth → Providers → Google
# See docs/google-sso-setup.md
